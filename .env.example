ALGORITHM=HS256
ALLOWED_ORIGINS=*
DATABASE_URL=
ENVIRONMENT=production
HOST=0.0.0.0
LOG_LEVEL=info
SECRET_KEY=
# Self-Hosted Open-Source LLM Server (Zero Per-Message Token Billing)
# Supports vLLM, Ollama, LocalAI, or any OpenAI-compatible API
SELF_HOSTED_LLM_URL=
SELF_HOSTED_LLM_API_KEY=
SELF_HOSTED_LLM_MODEL=qwen2.5:3b-instruct
SELF_HOSTED_LLM_TIMEOUT_MS=7000
SELF_HOSTED_LLM_MAX_TOKENS=300
# Optional Self-Hosted Vector Embeddings (BGE / MiniLM / Ollama)
SELF_HOSTED_EMBEDDING_URL=
EMBEDDING_MODEL=all-minilm
